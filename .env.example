# ==============================================================================
# HyperLocal Weather Engine - Environment Configuration Template
# Copy this file to .env and fill in your local network credentials.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# Home Assistant Core Connection
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your_home_assistant_long_lived_access_token_here
HA_NOTIFY_SERVICE=notify.notify

# Mosquitto MQTT Broker
MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_BASE_TOPIC=hyperlocal/weather

# Local AI LLM (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Optical Sky Vision (Frigate NVR or HTTP Snapshot Cameras)
FRIGATE_URL=http://frigate.local:5000
FRIGATE_CAMERAS=outside_sky_cam,outside_horizon_cam

# Web Dashboard Port
WEB_PORT=8080
